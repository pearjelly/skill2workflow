          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "expr": "sum by (status_class) (rate(skill2workflow_http_requests_total[5m]))",
          "legendFormat": "HTTP {{status_class}}",
          "refId": "A"
        }
      ],
      "title": "HTTP response rate by class",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
