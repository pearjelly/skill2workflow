{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://skill2workflow.dev/schemas/workflow-bundle-0.1.0.schema.json",
  "title": "skill2workflow Workflow Bundle Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "workflow",
    "files",
    "connectors",
    "secret_hygiene"
  ],
  "properties": {
    "schema_version": {
      "const": "skill2workflow-workflow-bundle-0.1.0"
    },
    "workflow": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version", "schema_version", "status", "bytes", "sha256"],
      "properties": {
        "id": {"type": "string", "minLength": 1, "maxLength": 128},
        "version": {"type": "string", "minLength": 1, "maxLength": 64},
        "schema_version": {"type": "string", "const": "0.1.0"},
        "status": {"type": "string", "enum": ["draft", "published", "deprecated"]},
        "bytes": {"type": "integer", "minimum": 1, "maximum": 2097152},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "files": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "bytes", "sha256"],
        "properties": {
          "path": {"const": "workflow.json"},
          "bytes": {"type": "integer", "minimum": 1, "maximum": 2097152},
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
        }
      }
    },
    "connectors": {
      "type": "array",
      "maxItems": 64,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1, "maxLength": 128}
    },
    "secret_hygiene": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "findings"],
      "properties": {
        "status": {"const": "passed"},
        "findings": {"const": 0}
      }
    }
  }
}
