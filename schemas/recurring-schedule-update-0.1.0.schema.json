{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://skill2workflow.dev/schemas/recurring-schedule-update-0.1.0.schema.json",
  "title": "skill2workflow recurring schedule update response",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "schedule_id",
    "workflow_id",
    "workflow_version",
    "status",
    "enabled",
    "starts_at",
    "next_run_at",
    "interval_seconds",
    "missed_run_policy",
    "changed"
  ],
  "properties": {
    "schema_version": {
      "const": "skill2workflow-recurring-schedule-update-0.1.0"
    },
    "schedule_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9._-]+$"
    },
    "workflow_id": {
      "type": "string",
      "minLength": 1
    },
    "workflow_version": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "enum": ["active", "disabled"]
    },
    "enabled": {
      "type": "boolean"
    },
    "starts_at": {
      "type": "string",
      "minLength": 1
    },
    "next_run_at": {
      "type": "string",
      "minLength": 1
    },
    "interval_seconds": {
      "type": "integer",
      "minimum": 1,
      "maximum": 31536000
    },
    "missed_run_policy": {
      "enum": ["latest", "skip"]
    },
    "changed": {
      "type": "boolean"
    }
  }
}
