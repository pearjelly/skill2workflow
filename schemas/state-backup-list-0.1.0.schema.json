{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://skill2workflow.dev/schemas/state-backup-list-0.1.0.schema.json",
  "title": "skill2workflow bounded local state-backup inventory",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "status", "total", "backups", "window"],
  "properties": {
    "schema_version": {
      "const": "skill2workflow-state-backup-list-0.1.0"
    },
    "status": {
      "const": "ok"
    },
    "total": {
      "type": "integer",
      "minimum": 0
    },
    "backups": {
      "type": "array",
      "maxItems": 1000,
      "items": {
        "$ref": "#/$defs/backup"
      }
    },
    "window": {
      "$ref": "#/$defs/window"
    }
  },
  "$defs": {
    "backup": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "status",
        "created_at",
        "state_layout_version",
        "workflow_artifact_count",
        "file_count",
        "total_bytes"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 255
        },
        "status": {
          "enum": ["valid", "invalid"]
        },
        "created_at": {
          "type": "string"
        },
        "state_layout_version": {
          "enum": [
            "",
            "skill2workflow-sqlite-layout-legacy-unversioned",
            "skill2workflow-sqlite-layout-0.1.0"
          ]
        },
        "workflow_artifact_count": {
          "type": "integer",
          "minimum": 0
        },
        "file_count": {
          "type": "integer",
          "minimum": 0
        },
        "total_bytes": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "window": {
      "type": "object",
      "additionalProperties": false,
      "required": ["max_items", "returned", "truncated"],
      "properties": {
        "max_items": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000
        },
        "returned": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000
        },
        "truncated": {
          "type": "boolean"
        }
      }
    }
  }
}
