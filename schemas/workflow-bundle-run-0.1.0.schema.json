{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://skill2workflow.dev/schemas/workflow-bundle-run-0.1.0.schema.json",
  "title": "skill2workflow blocked Workflow Bundle run admission",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "status",
    "workflow",
    "bundle_sha256",
    "reason",
    "summary",
    "safety"
  ],
  "properties": {
    "schema_version": {
      "const": "skill2workflow-workflow-bundle-run-0.1.0"
    },
    "status": {"const": "blocked"},
    "workflow": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version", "status"],
      "properties": {
        "id": {"type": "string", "minLength": 1, "maxLength": 128},
        "version": {"type": "string", "minLength": 1, "maxLength": 64},
        "status": {"type": "string", "enum": ["draft", "published", "deprecated"]}
      }
    },
    "bundle_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "reason": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "required_flag"],
      "properties": {
        "code": {"const": "side_effect_consent_required"},
        "required_flag": {"const": "--allow-side-effects"}
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["side_effecting_node_count"],
      "properties": {
        "side_effecting_node_count": {"type": "integer", "minimum": 1, "maximum": 1000}
      }
    },
    "safety": {
      "type": "object",
      "additionalProperties": false,
      "required": ["state_created", "credentials_resolved", "connector_calls", "raw_values_included"],
      "properties": {
        "state_created": {"const": false},
        "credentials_resolved": {"const": false},
        "connector_calls": {"const": false},
        "raw_values_included": {"const": false}
      }
    }
  }
}
