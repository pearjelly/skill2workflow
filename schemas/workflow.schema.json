{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://skill2workflow.dev/schemas/workflow-0.1.0.json",
  "title": "skill2workflow Workflow DSL",
  "description": "Workflow DSL document used as the execution truth source for skill2workflow.",
  "type": "object",
  "additionalProperties": true,
  "required": ["schema_version", "workflow", "entry", "nodes", "edges"],
  "properties": {
    "schema_version": {
      "const": "0.1.0",
      "description": "Workflow DSL schema version."
    },
    "workflow": {
      "$ref": "#/$defs/workflow_metadata"
    },
    "entry": {
      "type": "string",
      "minLength": 1,
      "description": "Node id where execution starts."
    },
    "nodes": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/node"
      },
      "minItems": 1
    },
    "edges": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/edge"
      }
    },
    "input_schema": {
      "$ref": "#/$defs/input_schema",
      "description": "Optional bounded JSON-Schema-like contract for trigger input. The runtime supports only the documented subset in docs/workflow-dsl-contract.md."
    },
    "state_schema": {
      "type": "object",
      "description": "Optional workflow state schema for future typed execution state."
    },
    "guards": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/guard"
      },
      "default": []
    },
    "checkpoints": {
      "type": "array",
      "items": {
        "type": "object"
      },
      "default": []
    },
    "policies": {
      "$ref": "#/$defs/policies"
    }
  },
  "$defs": {
    "workflow_metadata": {
      "type": "object",
      "additionalProperties": true,
      "required": ["id", "name", "version", "status"],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string"
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "type": "string",
          "enum": ["draft", "published", "deprecated"]
        }
      }
    },
    "node": {
      "type": "object",
      "additionalProperties": true,
      "required": ["id", "type", "title"],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "type": {
          "type": "string",
          "enum": ["start", "step", "human_gate", "tool_call", "verification", "instruction", "failure", "end"]
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string"
        },
        "requires": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "produces": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "guard": {
          "type": ["object", "string", "null"]
        },
        "action": {
          "type": ["object", "null"]
        },
        "retry": {
          "type": ["object", "null"]
        },
        "connector": {
          "$ref": "#/$defs/connector_binding"
        },
        "metadata": {
          "type": "object"
        },
        "on_success": {
          "type": "string"
        },
        "on_failure": {
          "type": "string"
        },
        "on_fallback": {
          "type": "string",
          "description": "Optional tool_call transition used after connector retries are exhausted; the failed node remains recorded and the fallback path must be explicit in edges."
        }
      }
    },
    "connector_binding": {
      "type": "object",
      "additionalProperties": true,
      "required": ["id"],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "type": "string"
        },
        "request": {
          "$ref": "#/$defs/connector_request"
        },
        "credentials": {
          "type": "array",
          "description": "Optional credential handle metadata. The built-in HTTP connector supports header credentials resolved by the local credential provider."
        }
      }
    },
    "connector_request": {
      "type": "object",
      "additionalProperties": true,
      "description": "Optional connector request metadata. The built-in HTTP connector uses this object.",
      "properties": {
        "method": {
          "type": "string"
        },
        "url": {
          "type": "string"
        },
        "headers": {
          "type": "object"
        },
        "body": {},
        "timeout_ms": {
          "type": "integer"
        },
        "input_mapping": {
          "type": "array",
          "description": "Optional body-only mapping from run context input into HTTP request body fields.",
          "items": {
            "type": "object",
            "additionalProperties": true,
            "required": ["from", "to"],
            "properties": {
              "from": {
                "type": "string",
                "pattern": "^/input/.+"
              },
              "to": {
                "type": "string",
                "pattern": "^/body/.+"
              },
              "required": {
                "type": "boolean",
                "default": true
              }
            }
          }
        }
      }
    },
    "edge": {
      "type": "object",
      "additionalProperties": true,
      "required": ["id", "from", "to"],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "from": {
          "type": "string",
          "minLength": 1
        },
        "to": {
          "type": "string",
          "minLength": 1
        },
        "label": {
          "type": ["string", "null"]
        },
        "condition": {
          "type": ["object", "string", "null"]
        }
      }
    },
    "input_schema": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type"],
      "description": "Bounded trigger-input contract. Root type must be object; supported types are object, array, string, integer, number, boolean, and null.",
      "properties": {
        "type": {
          "const": "object"
        },
        "properties": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/input_schema_node"
          }
        },
        "required": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "additionalProperties": {
          "type": "boolean",
          "default": true
        },
        "enum": {
          "type": "array",
          "minItems": 1,
          "maxItems": 128
        }
      }
    },
    "input_schema_node": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type"],
      "properties": {
        "type": {
          "type": "string",
          "enum": ["object", "array", "string", "integer", "number", "boolean", "null"]
        },
        "properties": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/input_schema_node"
          }
        },
        "required": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "additionalProperties": {
          "type": "boolean",
          "default": true
        },
        "items": {
          "$ref": "#/$defs/input_schema_node"
        },
        "minLength": {
          "type": "integer",
          "minimum": 0
        },
        "maxLength": {
          "type": "integer",
          "minimum": 0
        },
        "minimum": {
          "type": "number"
        },
        "maximum": {
          "type": "number"
        },
        "enum": {
          "type": "array",
          "minItems": 1,
          "maxItems": 128
        }
      }
    },
    "guard": {
      "type": "object",
      "additionalProperties": true,
      "required": ["id", "description"],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string"
        }
      }
    },
    "policies": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "default_retry": {
          "type": "object"
        },
        "default_timeout_ms": {
          "type": "integer",
          "minimum": 0,
          "maximum": 86400000,
          "description": "Maximum active execution segment in milliseconds; zero disables the boundary. Human-gate waiting is paused."
        }
      }
    }
  }
}
