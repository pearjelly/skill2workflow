{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://skill2workflow.dev/schemas/local-schedule-list-0.1.0.schema.json",
  "title": "skill2workflow bounded local schedule inventory",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "summary", "schedules", "window"],
  "properties": {
    "schema_version": {"const": "skill2workflow-local-schedule-list-0.1.0"},
    "summary": {"$ref": "#/$defs/summary"},
    "schedules": {
      "type": "array",
      "maxItems": 1000,
      "items": {"$ref": "#/$defs/schedule"}
    },
    "window": {"$ref": "#/$defs/window"}
  },
  "$defs": {
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["total", "status_counts"],
      "properties": {
        "total": {"type": "integer", "minimum": 0},
        "status_counts": {
          "type": "object",
          "additionalProperties": false,
          "required": ["active", "pending", "completed", "disabled", "other"],
          "properties": {
            "active": {"type": "integer", "minimum": 0},
            "pending": {"type": "integer", "minimum": 0},
            "completed": {"type": "integer", "minimum": 0},
            "disabled": {"type": "integer", "minimum": 0},
            "other": {"type": "integer", "minimum": 0}
          }
        }
      }
    },
    "schedule": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind", "schedule_id", "workflow_id", "workflow_version", "status",
        "enabled", "run_at", "starts_at", "next_run_at", "interval_seconds",
        "missed_run_policy", "last_activity_at", "last_run_at",
        "last_scheduled_for", "last_run_id", "last_trigger_id"
      ],
      "properties": {
        "kind": {"enum": ["one_shot", "recurring"]},
        "schedule_id": {"type": "string", "minLength": 1, "maxLength": 128},
        "workflow_id": {"type": "string", "minLength": 1},
        "workflow_version": {"type": "string", "minLength": 1},
        "status": {"enum": ["active", "pending", "completed", "disabled", "other"]},
        "enabled": {"type": "boolean"},
        "run_at": {"type": "string"},
        "starts_at": {"type": "string"},
        "next_run_at": {"type": "string"},
        "interval_seconds": {"type": "integer", "minimum": 0},
        "missed_run_policy": {"type": "string"},
        "last_activity_at": {"type": "string"},
        "last_run_at": {"type": "string"},
        "last_scheduled_for": {"type": "string"},
        "last_run_id": {"type": "string"},
        "last_trigger_id": {"type": "string"}
      }
    },
    "window": {
      "type": "object",
      "additionalProperties": false,
      "required": ["max_items", "total", "returned", "truncated"],
      "properties": {
        "max_items": {"type": "integer", "minimum": 1, "maximum": 1000},
        "total": {"type": "integer", "minimum": 0},
        "returned": {"type": "integer", "minimum": 0, "maximum": 1000},
        "truncated": {"type": "boolean"}
      }
    }
  }
}
