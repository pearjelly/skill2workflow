{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://skill2workflow.dev/schemas/backup-retention-policy-0.1.0.schema.json",
  "title": "skill2workflow local backup retention policy 0.1.0",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "retention"],
  "properties": {
    "schema_version": {
      "const": "skill2workflow-backup-retention-policy-0.1.0"
    },
    "retention": {
      "type": "object",
      "additionalProperties": false,
      "required": ["expire_before", "minimum_keep"],
      "properties": {
        "expire_before": {
          "type": "string",
          "format": "date-time"
        },
        "minimum_keep": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000
        }
      }
    }
  }
}
